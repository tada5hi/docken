{
    "extends": "@tada5hi/tsconfig",
    "compilerOptions": {
        "lib": [
            "ESNext",
            "DOM"
        ],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noUncheckedIndexedAccess": false,
        "ignoreDeprecations": "6.0",
        "target": "ESNext"
    },
    "include": [
        "src/**/*.ts",
        "test/**/*.ts",
        "test/**/*.mts"
    ],
    "exclude": [
        "node_modules/**/*"
    ]
}
