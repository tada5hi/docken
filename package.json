{
    "name": "docken",
    "version": "2.0.2",
    "description": "A library providing utilities for the interaction with docker.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/tada5hi/docken.git"
    },
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./client": {
            "types": "./lib/dockerode/index.d.ts",
            "import": "./lib/dockerode/index.mjs",
            "require": "./lib/dockerode/index.cjs"
        }
    },
    "files": [
        "dist",
        "lib"
    ],
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "build:types": "tsc --emitDeclarationOnly",
        "build:js": "tsdown",
        "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run build:js",
        "test": "cross-env NODE_ENV=test vitest run --config test/vitest.config.mts",
        "test:coverage": "npm test -- --coverage",
        "prepublishOnly": "npm run build",
        "lint": "eslint src AGENTS.md CLAUDE.md .agents",
        "lint:fix": "npm run lint -- --fix"
    },
    "keywords": [
        "docker",
        "image",
        "image-group",
        "client",
        "scan",
        "metadata",
        "groups"
    ],
    "license": "MIT",
    "devDependencies": {
        "@swc/core": "^1.16.21",
        "@tada5hi/eslint-config": "^3.3.1",
        "@tada5hi/tsconfig": "^0.7.2",
        "@types/node": "^24.10.1",
        "@vitest/coverage-v8": "^5.1.0",
        "cross-env": "^10.1.0",
        "eslint": "^10.14.0",
        "monoship": "^2.2.1",
        "rimraf": "^6.1.3",
        "tsdown": "^0.23.7",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "@types/dockerode": "^4.0.1",
        "dockerode": "^4.0.10",
        "locter": "^2.2.1",
        "smob": "^1.6.1"
    }
}
