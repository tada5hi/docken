{
    "name": "docken",
    "version": "2.0.2",
    "description": "A library providing utilities for the interaction with docker.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/tada5hi/docken.git"
    },
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./client": {
            "types": "./lib/dockerode/index.d.ts",
            "import": "./lib/dockerode/index.mjs",
            "require": "./lib/dockerode/index.cjs"
        }
    },
    "files": [
        "dist",
        "lib"
    ],
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "build:types": "tsc --emitDeclarationOnly",
        "build:js": "rollup -c",
        "build": "rimraf dist && npm run build:types && npm run build:js",
        "test": "cross-env NODE_ENV=test jest --config ./test/jest.config.js",
        "test:coverage": "cross-env NODE_ENV=test jest --config ./test/jest.config.js --coverage",
        "prepublishOnly": "npm run build",
        "lint": "eslint --ext .js,.vue,.ts ./src",
        "lint:fix": "npm run lint -- --fix"
    },
    "keywords": [
        "docker",
        "image",
        "image-group",
        "client",
        "scan",
        "metadata",
        "groups"
    ],
    "license": "MIT",
    "devDependencies": {
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-swc": "^0.4.0",
        "@swc/core": "^1.15.21",
        "@tada5hi/eslint-config-typescript": "^1.2.17",
        "@tada5hi/tsconfig": "^0.7.2",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.19.1",
        "cross-env": "^10.1.0",
        "eslint": "^10.13.0",
        "jest": "^30.3.0",
        "rimraf": "^6.1.3",
        "rollup": "^4.60.0",
        "ts-jest": "^29.4.6",
        "typescript": "^5.9.3",
        "workspaces-publish": "^1.8.1"
    },
    "dependencies": {
        "@types/dockerode": "^4.0.1",
        "dockerode": "^4.0.10",
        "locter": "^2.2.1",
        "smob": "^1.6.1"
    }
}
