{
    "name": "docken",
    "version": "3.0.0",
    "description": "A library providing utilities for the interaction with docker.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/tada5hi/docken.git"
    },
    "type": "module",
    "main": "dist/index.mjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        },
        "./client": {
            "types": "./lib/dockerode/index.d.ts",
            "import": "./lib/dockerode/index.mjs"
        }
    },
    "files": [
        "dist",
        "lib",
        ".github/assets"
    ],
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "build:types": "tsc --noEmit",
        "build:js": "tsdown",
        "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run build:types && npm run build:js",
        "test": "cross-env NODE_ENV=test vitest run --config test/vitest.config.mts",
        "test:coverage": "npm test -- --coverage",
        "prepublishOnly": "npm run build",
        "lint": "eslint src lib AGENTS.md CLAUDE.md .agents",
        "lint:fix": "npm run lint -- --fix"
    },
    "keywords": [
        "docker",
        "image",
        "image-group",
        "client",
        "scan",
        "metadata",
        "groups"
    ],
    "license": "MIT",
    "devDependencies": {
        "@swc/core": "^1.16.22",
        "@tada5hi/eslint-config": "^3.3.1",
        "@tada5hi/tsconfig": "^0.7.2",
        "@types/node": "^24.19.2",
        "@types/tar-fs": "^2.0.4",
        "@vitest/coverage-v8": "^5.1.1",
        "cross-env": "^10.1.0",
        "eslint": "^10.15.0",
        "monoship": "^2.2.1",
        "rimraf": "^6.1.4",
        "tsdown": "^0.23.7",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.74.0",
        "vitest": "^5.1.1"
    },
    "dependencies": {
        "@balena/dockerignore": "^1.0.2",
        "@types/dockerode": "^4.0.2",
        "dockerode": "^5.0.1",
        "locter": "^4.3.0",
        "smob": "^1.6.2",
        "tar-fs": "^2.1.6"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^24.15.0 || >=26.0.0",
            "onFail": "warn"
        }
    }
}
